# n8n Configuration
N8N_BASIC_AUTH_ACTIVE=false
N8N_PORT=5678
N8N_HOST=localhost

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Backend API
BACKEND_URL=http://localhost:5000

# Webhook URLs (Auto-generated by n8n)
WEBHOOK_ANALYZE_PROMPT=http://localhost:5678/webhook/analyze-prompt
WEBHOOK_PLAN_COURSE=http://localhost:5678/webhook/plan-course
WEBHOOK_GENERATE_LESSONS=http://localhost:5678/webhook/generate-lessons
WEBHOOK_GENERATE_VIDEOS=http://localhost:5678/webhook/generate-videos

# Storage (for videos and media)
MEDIA_STORAGE_PATH=/path/to/media/storage

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
